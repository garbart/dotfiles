# Ghostty config. install.sh links it to ~/.config/ghostty/config.ghostty on
# macOS; remote machines are reached through it over ssh and need nothing.

# Light/dark follows macOS. The palettes are the ones of the jb.nvim theme
# (see themes/), so the shell and Neovim look the same, and Neovim switches
# along with Ghostty.
theme = light:jb-light,dark:jb-dark

window-padding-x = 8
window-padding-y = 4
window-padding-balance = true

# Over ssh, install Ghostty's terminfo on the remote host, falling back to
# xterm-256color where that's not possible.
shell-integration-features = ssh-env,ssh-terminfo

# VSCode shortcuts for Neovim. Cmd+key is sent to the app as a Super-key CSI u
# sequence, which nvim reads as <D-key> (over ssh too); Cmd+Shift+key arrives
# as <D-KEY>. At the zsh prompt Cmd+W closes the shell and the others do
# nothing (see zsh/zshrc).
#
# The keys are physical (key_w, not w), so they work in any keyboard layout:
# in the Russian one W types "ц" and a plain `w` binding never matches.
keybind = super+key_s=csi:115;9u
keybind = super+key_p=csi:112;9u
keybind = super+shift+key_p=csi:112;10u
keybind = super+shift+key_o=csi:111;10u
keybind = super+key_f=csi:102;9u
keybind = super+shift+key_f=csi:102;10u
keybind = super+key_w=csi:119;9u
keybind = super+key_b=csi:98;9u
keybind = super+slash=csi:47;9u
# Ctrl+Tab / Ctrl+Shift+Tab switch Neovim's tabs; Ghostty's own tabs are on
# Cmd+1..9 and Cmd+Shift+[ / ], and Cmd+D / Cmd+Shift+D split off a shell.
keybind = ctrl+tab=csi:9;5u
keybind = ctrl+shift+tab=csi:9;6u
# Cmd+Shift+W closes the Ghostty tab (Ghostty's own closed the whole
# window); Cmd+W stays the tab of Neovim (at the zsh prompt it closes the
# shell, and so the Ghostty tab).
keybind = super+shift+key_w=close_tab:this
# Cmd+Shift+T reopens the last closed tab of Neovim, as in VSCode. Ghostty's
# own (Undo, which brings back a tab closed in the last few seconds) is left
# in its Edit menu.
keybind = super+shift+key_t=csi:116;10u

# Editing shortcuts as in any Mac app: select all, undo, redo, cut go to
# Neovim. Cmd+C copies a terminal selection when there is one; otherwise the
# key goes on to the app (Neovim copies its own selection; at the shell it
# does nothing). That key is in the current layout, Cmd+С in the Russian one,
# and Neovim takes both (see keymaps.lua). Cmd+V stays Ghostty's paste, which
# also brings the Mac clipboard into Neovim over ssh; bound here to the
# physical key, as Ghostty's own binding is to the letter.
keybind = super+key_a=csi:97;9u
keybind = super+key_z=csi:122;9u
keybind = super+shift+key_z=csi:122;10u
keybind = super+key_x=csi:120;9u
keybind = performable:super+key_c=copy_to_clipboard:mixed
keybind = super+key_v=paste_from_clipboard
# Cmd+Shift+C goes to Neovim (the full path of a file in the tree).
keybind = super+shift+key_c=csi:99;10u
# Cmd+Shift+V goes to Neovim too (Markdown view); Ghostty's own pasted its
# last terminal selection, which in Neovim is a piece of the screen.
keybind = super+shift+key_v=csi:118;10u
# Cmd+G reverts the git changes in the selected lines in Neovim; Ghostty's
# own went to the next search match.
keybind = super+key_g=csi:103;9u
# Shift+click goes to the program (Neovim: selecting several files in the
# tree, extending a selection in code) instead of selecting the screen's
# text in Ghostty.
mouse-shift-capture = true

# Option+Delete deletes the word before the cursor (Alt+Backspace, which
# Neovim and zsh both take for that). Ghostty sends it on its own only in the
# U.S. layout; in ABC or Russian, Option goes to macOS for typing letters and
# the key arrived as a plain Delete. Option+Fn+Delete and Option+arrows are
# sent with Alt in any layout already.
keybind = alt+backspace=text:\x1b\x7f

# Drop Ghostty's own bindings of these keys: their menu items (Close, Find,
# Find Next, Command Palette, Select All, Undo, Redo, Copy, Paste Selection,
# Close Window) would otherwise grab the keys before they reach Neovim or the
# bindings above.
keybind = super+w=unbind
keybind = super+shift+w=unbind
keybind = super+shift+t=unbind
keybind = super+f=unbind
keybind = super+g=unbind
keybind = super+shift+f=unbind
keybind = super+shift+p=unbind
keybind = super+a=unbind
keybind = super+z=unbind
keybind = super+shift+z=unbind
keybind = super+c=unbind
keybind = super+shift+v=unbind
