# ─── Format ──────────────────────────────────────────
format = """
$hostname\
[@](fg:muted)\
$username\
[:](fg:muted)\
$directory\
$git_branch\
$git_status\
\n$character"""

add_newline = false
palette = "terminal"

# ─── Palette ─────────────────────────────────────────
# The terminal's own ANSI colors, so the prompt follows its light/dark theme
# (ghostty/themes) instead of fixed colors made for a dark background.
[palettes.terminal]
muted = "bright-black"

red = "red"
green = "green"
yellow = "yellow"
blue = "blue"
purple = "purple"
cyan = "cyan"

[username]
show_always = true
style_user = "fg:muted"
style_root = "fg:red bold"
format = "[$user]($style)"

[hostname]
ssh_only = false
format = "[$hostname]($style)"
style = "fg:muted"

[directory]
style = "fg:blue bold"
format = "[$path]($style)"
truncate_to_repo = false
truncation_length = 999

# ─── Git ─────────────────────────────────────────────
[git_branch]
symbol = ""
style = "fg:purple"
format = "[  $branch]($style)"

[git_status]
style = "fg:yellow"
format = '[$untracked]($style)'
untracked = " *"

# ─── Prompt Symbol ───────────────────────────────────
[character]
success_symbol = "[\\$](fg:green bold)"
error_symbol = "[\\$](fg:red bold)"
vimcmd_symbol = "[\\$](fg:green bold)"
